# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/video_meetings

# Backend
PORT=3001
NODE_ENV=development
# Секрет подписи JWT; обязателен при NODE_ENV=production (сгенерируйте: openssl rand -hex 32)
JWT_SECRET=change-me-to-a-long-random-string
# Каталог хранилища загруженных файлов (относительно cwd backend)
FILES_STORAGE_DIR=storage
# Максимальный размер файла в байтах (2 ГиБ)
MAX_FILE_SIZE=2147483648

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001
